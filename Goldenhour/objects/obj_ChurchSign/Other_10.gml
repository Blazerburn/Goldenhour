reset_dialogue_defaults();


switch(choice_variable){
	case -1:
	#region First Dialogue
		//Line 0
		var i = 0;
		myText[i]		= "'Church of the Dreamers";
		mySpeaker[i]	= id;
		
		//Line 4
		i++;
		myText[i]		= "Please do not disturb the interior'";
		mySpeaker[i]	= id;
		
	#endregion
	break;
}