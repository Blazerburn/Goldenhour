//---You can update variables here!---//
reset_dialogue_defaults();


switch(choice_variable){
	case -1:
	#region First Dialogue
		//Line 0
		var i = 0;
		myText[i]		= "A large poofy bed";
		mySpeaker[i]	= id;
		
		//Line 1
		i++
		myText[i]		= "The blankets and sheets have been torn up someone";
		mySpeaker[i]	= id;
		
		//Line 2
		i++
		myText[i]		= "It's a bit of a shame";
		mySpeaker[i]	= id;
		
		//Line 3
		i++
		myText[i]		= "It's colors are very pretty in this blue landscape";
		mySpeaker[i]	= id;
		
		//Line 4
		i++
		myText[i]		= "Then your eyes drift up from the bed to the painting behind it";
		mySpeaker[i]	= id;
		
		//Line 5
		i++
		myText[i]		= "It looks like the same royal as that statue";
		mySpeaker[i]	= id;
		
		//Line 6
		i++
		myText[i]		= "You can assume this was his room, but...";
		mySpeaker[i]	= id;
		
		//Line 7
		i++
		myText[i]		= "You only wonder what happened to him";
		mySpeaker[i]	= id;
	#endregion
	break;
}